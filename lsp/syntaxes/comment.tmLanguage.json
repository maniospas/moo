{
  "scopeName": "comment.block.moo",
  "patterns": [
    {
      "begin": "\\/\\*\\*\\*",
      "end": "\\*\\*\\*\\/",
      "contentName": "source.moo",
      "patterns": [
        {
          "match": "(?<=/\\*\\*\\*)\\s*([A-Za-z_]\\w*)\\s*(?=:)",
          "captures": {
            "1": { "name": "entity.name.namespace" }
          }
        },
        {
          "match": "(?<=/\\*\\*\\*)\\s*([A-Za-z_]\\w*)\\s*(?==)",
          "captures": {
            "1": { "name": "variable.other.constant" }
          }
        },
        {
          "match": "(?<=/\\*\\*\\*)\\s*([A-Za-z_]\\w*)\\s*(?=\\+\\=)",
          "captures": {
            "1": { "name": "variable.other.constant" }
          }
        },
        {
          "match": "(?<=\\bappend\\s+)([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "variable.other.constant" }
          }
        },
        {
          "match": "(?<=\\{)\\s*([A-Za-z_]\\w*)\\s*(?=\\})",
          "captures": {
            "1": { "name": "variable.other.constant" }
          }
        },
        {
          "match": "(?<=/\\*\\*\\*)\\s*([A-Za-z_]\\w*)\\s*(?=\\*\\*\\*/)",
          "captures": {
            "1": { "name": "variable.other.constant" }
          }
        },
        {
          "match": "(?:(?<=:|=|\\{)|(?<=\\A|\\n|\\/\\*\\*\\*))\\s*(\\b[a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "entity.name.function" }
          }
        },
        {
          "match": "[=:{}+]",
          "name": "keyword.operator"
        }
      ]
    }
  ]
}
