{
  "scopeName": "comment.block.moo",
  "patterns": [
    {
      "begin": "\\/\\*\\*\\*",
      "end": "\\*\\*\\*\\/",
      "contentName": "source.moo",
      "patterns": [
        {
          "match": "(?<=/\\*\\*\\*)\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "entity.name.namespace" }
          }
        },
        {
          "match": "(?<=\\{)\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "entity.name.namespace" }
          }
        },
        {
          "match": "(?<=/\\*\\*\\*|\\:)\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*(?==)",
          "captures": {
            "1": { "name": "variable.other.constant" }
          }
        },
        {
          "match": "(?<=/\\*\\*\\*|\\:)\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*(?=\\+\\=)",
          "captures": {
            "1": { "name": "variable.other.constant" }
          }
        },
        {
          "match": "(?<=[{:])\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*(?=\\})",
          "captures": {
            "1": { "name": "variable.other.constant" }
          }
        },
        {
          "match": "(?<=/\\*\\*\\*|\\:)\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*(?=\\*\\*\\*/)",
          "captures": {
            "1": { "name": "variable.other.constant" }
          }
        },
        {
          "match": "(?:(?<=\\:|=|\\{|\\/\\*\\*\\*|\\/\\*\\*/))\\s*(\\b[a-zA-Z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "entity.name.function" }
          }
        },
        {
          "match": "[=:{}+]",
          "name": "keyword.operator"
        }
      ]
    },
    {
      "begin": "\\/\\*\\*\\/",
      "end": "\\n",
      "contentName": "source.moo",
      "patterns": [
        {
          "match": "(?<=/\\*\\*\\/)\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "entity.name.namespace" }
          }
        },
        {
          "match": "(?<=\\{)\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "entity.name.namespace" }
          }
        },
        {
          "match": "(?<=/\\*\\*\\/|\\:)\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*(?==)",
          "captures": {
            "1": { "name": "variable.other.constant" }
          }
        },
        {
          "match": "(?<=/\\*\\*\\/|\\:)\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*(?=\\+\\=)",
          "captures": {
            "1": { "name": "variable.other.constant" }
          }
        },
        {
          "match": "(?<=[{:])\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*(?=\\})",
          "captures": {
            "1": { "name": "variable.other.constant" }
          }
        },
        {
          "match": "(?<=/\\*\\*\\/|\\:)\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*(?=\\n)",
          "captures": {
            "1": { "name": "variable.other.constant" }
          }
        },
        {
          "match": "(?:(?<=:|=|\\{)|(?<=\\A|\\n|\\/\\*\\*\\/))\\s*(\\b[a-zA-Z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "entity.name.function" }
          }
        },
        {
          "match": "[=:{}+]",
          "name": "keyword.operator"
        }
      ]
    }
  ]
}
